{
  "name": "deadcards",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply deadcards --local",
    "db:migrate:remote": "wrangler d1 migrations apply deadcards --remote",
    "typegen": "wrangler types",
    "db:import": "node scripts/import-save.mjs",
    "test": "tsc -p test && vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "gsap": "^3.15.1",
    "html-to-image": "1.11.13",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.15.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.3.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.20.0"
  }
}
